<?xml version="1.0"?>
<!--
  Molecular collision data for dsmc1d (model=vhs|vss species=<id>).
  Source: Bird (1994), Molecular Gas Dynamics and the DSMC of Gas Flows,
  Appendix A, Tables A1 (VHS) and A2 (VSS); Tref = 273 K.
  Same content as SPARTA data/*.species + *.vss, one file per gas set.

  mass [kg], diam [m], tref [K]; omega = viscosity-temperature exponent
  (mu ~ T^omega); alpha = VSS scattering exponent (alpha = 1 -> VHS).
  rotdof/vibdof are recorded for completeness; dsmc1d is monatomic (no
  Larsen-Borgnakke yet), so rotdof > 0 only triggers a warning.
-->
<gasdata>
  <species id="He" mass="6.65e-27" rotdof="0" vibdof="0">
    <vhs diam="2.33e-10" omega="0.66" tref="273.0"/>
    <vss diam="2.30e-10" omega="0.66" tref="273.0" alpha="1.26"/>
  </species>
  <species id="Ne" mass="3.35e-26" rotdof="0" vibdof="0">
    <vhs diam="2.77e-10" omega="0.66" tref="273.0"/>
